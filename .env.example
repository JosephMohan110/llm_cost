# API key must be kept on the server; never expose it in a browser/mobile app.
OPENAI_API_KEY=replace-with-your-api-key

# Verify model availability for your account and update rates from the current pricing page.
LLM_CHEAP_MODEL=gpt-6-luna
LLM_STRONG_MODEL=gpt-6.1-sol
LLM_CHEAP_INPUT_USD_PER_1M=0.05
LLM_CHEAP_CACHED_INPUT_USD_PER_1M=0.005
LLM_CHEAP_CACHE_WRITE_USD_PER_1M=0.0625
LLM_CHEAP_OUTPUT_USD_PER_1M=0.25
LLM_STRONG_INPUT_USD_PER_1M=1.00
LLM_STRONG_CACHED_INPUT_USD_PER_1M=0.05
LLM_STRONG_CACHE_WRITE_USD_PER_1M=1.25
LLM_STRONG_OUTPUT_USD_PER_1M=5.00

LLM_MAX_OUTPUT_TOKENS=350
LLM_MAX_CONTEXT_TOKENS=1800
LLM_PROVIDER_TIMEOUT_SECONDS=30
# Number of additional attempts for transient provider timeouts, connection errors, 429s, and 5xx responses.
LLM_MAX_PROVIDER_RETRIES=1
LLM_RETRY_BACKOFF_SECONDS=0.25
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_ENABLED=true
LLM_ROUTING_ENABLED=true
LLM_DAILY_BUDGET_USD=5.00
LLM_DB_PATH=.llm_cost_optimizer.sqlite3
LLM_PROMPT_VERSION=support-answer-v1
LLM_ROUTE_POLICY_VERSION=support-route-v1
LLM_MAX_QUERY_CHARS=8000
LLM_SIMPLE_QUERY_MAX_CHARS=450
LLM_STRONG_CONTEXT_THRESHOLD_TOKENS=1200
